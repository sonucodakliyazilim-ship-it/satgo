# Backend production env
NODE_ENV=production
PORT=5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=satgo_db
DB_USER=satgo_user
DB_PASSWORD=change_me
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

JWT_SECRET=change_me_long_random_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_another_long_random_value
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_NAME=Satgo Admin
ADMIN_EMAIL=admin@satgo.tr
ADMIN_PASSWORD=change_me_admin_password_min_8_chars

BCRYPT_ROUNDS=12

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_FILES_PER_LISTING=10

# Use comma if you serve multiple frontends, e.g. https://satgo.tr,https://www.satgo.tr
FRONTEND_URL=https://satgo.tr

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

BANK_NAME=
IBAN=
IBAN_OWNER=

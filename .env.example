# Uploads and rate limiting
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
MAX_FILES_PER_LISTING=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

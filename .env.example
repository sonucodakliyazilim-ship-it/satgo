NODE_ENV=production
PORT=5000
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=https://satgo.vercel.app
BACKEND_URL=https://api.satgo.tr

# OAuth login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.satgo.tr/api/auth/oauth/google/callback
OAUTH_STATE_SECRET=

# Admin seed account
ADMIN_NAME=Satgo Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uploads and rate limiting
UPLOAD_DIR=uploads
LISTING_IMAGE_STORAGE=database
MAX_FILE_SIZE=15728640
MAX_FILES_PER_LISTING=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

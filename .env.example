NODE_ENV=production
PORT=5000
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
FRONTEND_URL=

# Optional database fields if DATABASE_URL is not used
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Admin seed account
ADMIN_NAME=Satgo Admin
ADMIN_EMAIL=
